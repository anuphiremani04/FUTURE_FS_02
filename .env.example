# ============================================
# ENVIRONMENT VARIABLES CONFIGURATION
# ============================================
# For Local Development, use localhost values
# For Render Deployment, use external database

NODE_ENV=production
PORT=5000

# JWT Configuration (IMPORTANT: Change in production!)
JWT_SECRET=replace_with_a_very_secure_random_secret_key_minimum_32_characters
JWT_EXPIRES_IN=7d

# ============================================
# DATABASE CONFIGURATION
# ============================================
# LOCAL DEVELOPMENT:
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=your_local_password
# DB_NAME=mini_crm

# RENDER DEPLOYMENT (Recommended: TiDB Cloud Free Tier)
# Sign up free at: https://tidbcloud.com
DB_HOST=your-tidb-cluster.c.tidb.cloud
DB_PORT=4000
DB_USER=your_tidb_username
DB_PASSWORD=your_tidb_password
DB_NAME=mini_crm

# ============================================
# FRONTEND CONFIGURATION
# ============================================
# LOCAL: http://127.0.0.1:5500
# RENDER: https://your-app-name.onrender.com (no trailing slash)
FRONTEND_ORIGIN=https://your-app-name.onrender.com
